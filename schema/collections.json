        { "key": "system", "displayName": "System / Edition", "type": "TEXT" },
        { "key": "playerCap", "displayName": "Player Cap", "type": "NUMBER" },
        { "key": "description", "displayName": "Description", "type": "TEXT" },
        { "key": "contentNotes", "displayName": "Content Notes", "type": "TEXT" },
        { "key": "seatsTaken", "displayName": "Seats Taken", "type": "NUMBER" },
        { "key": "waitlistCount", "displayName": "Waitlist Count", "type": "NUMBER" }
