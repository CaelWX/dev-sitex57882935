{
  "_comment": "Source of truth for the D&D booking CMS collections. Created on the site via the Wix Data Collections REST API (POST /wix-data/v2/collections). Order matters: referenced collections come first. Wix adds system fields (_id, _createdDate, _updatedDate, _owner) automatically.",
  "collections": [
    {
      "id": "EventSeries",
      "displayName": "Event Series",
      "displayField": "title",
      "permissions": { "read": "ANYONE", "insert": "ADMIN", "update": "ADMIN", "remove": "ADMIN" },
      "fields": [
        { "key": "title", "displayName": "Title", "type": "TEXT", "required": true },
        { "key": "description", "displayName": "Description", "type": "TEXT" },
        { "key": "venue", "displayName": "Venue", "type": "TEXT" },
        { "key": "dayOfWeek", "displayName": "Day of Week (0=Sun)", "type": "NUMBER", "numberRange": { "min": 0, "max": 6 } },
        { "key": "startTimeLocal", "displayName": "Start Time (local HH:mm)", "type": "TEXT" },
        { "key": "endTimeLocal", "displayName": "End Time (local HH:mm)", "type": "TEXT" },
        { "key": "timeZone", "displayName": "Time Zone", "type": "TEXT" },
        { "key": "tableCount", "displayName": "Number of Tables", "type": "NUMBER", "numberRange": { "min": 1, "max": 50 } },
        { "key": "defaultSeatsPerTable", "displayName": "Default Seats per Table", "type": "NUMBER", "numberRange": { "min": 1, "max": 20 } },
        { "key": "isOneOff", "displayName": "One-off Event", "type": "BOOLEAN" },
        { "key": "startsOn", "displayName": "Starts On", "type": "DATE" },
        { "key": "endsOn", "displayName": "Ends On", "type": "DATE" },
        { "key": "status", "displayName": "Status (active|paused|ended)", "type": "TEXT" },
        { "key": "generatedThrough", "displayName": "Generated Through", "type": "DATE" }
      ]
    },
    {
      "id": "Occurrences",
      "displayName": "Occurrences",
      "displayField": "title",
      "permissions": { "read": "ANYONE", "insert": "ADMIN", "update": "ADMIN", "remove": "ADMIN" },
      "fields": [
        { "key": "series", "displayName": "Series", "type": "REFERENCE", "typeMetadata": { "reference": { "referencedCollectionId": "EventSeries" } } },
        { "key": "localDate", "displayName": "Local Date", "type": "DATE" },
        { "key": "startsAt", "displayName": "Starts At (UTC)", "type": "DATETIME" },
        { "key": "endsAt", "displayName": "Ends At (UTC)", "type": "DATETIME" },
        { "key": "title", "displayName": "Title", "type": "TEXT" },
        { "key": "venue", "displayName": "Venue", "type": "TEXT" },
        { "key": "description", "displayName": "Description", "type": "TEXT" },
        { "key": "status", "displayName": "Status (scheduled|cancelled)", "type": "TEXT" },
        { "key": "cancelReason", "displayName": "Cancel Reason", "type": "TEXT" },
        { "key": "isCustomized", "displayName": "Customized by Admin", "type": "BOOLEAN" },
        { "key": "hasActivity", "displayName": "Has Claims or Bookings", "type": "BOOLEAN" }
      ]
    },
    {
      "id": "Tables",
      "displayName": "Tables",
      "displayField": "name",
      "permissions": { "read": "ANYONE", "insert": "ADMIN", "update": "ADMIN", "remove": "ADMIN" },
      "fields": [
        { "key": "occurrence", "displayName": "Occurrence", "type": "REFERENCE", "typeMetadata": { "reference": { "referencedCollectionId": "Occurrences" } } },
